{
  "schema_version": "1.1",
  "issue": "IHAP-50",
  "status": "proposed_until_project_owner_approval",
  "reference_mcu": "ESP32-C3",
  "pin_policy": {
    "reserved": {
      "GPIO2": "strapping",
      "GPIO8": "strapping",
      "GPIO9": "strapping",
      "GPIO20": "UART0/recovery preferred free",
      "GPIO21": "UART0/recovery preferred free"
    },
    "reference_allocation": {
      "GPIO0": "RADAR_RX_FROM_LD2410C_TX",
      "GPIO1": "RADAR_TX_TO_LD2410C_RX_SERVICE_ONLY",
      "GPIO3": "DOOR_SENSE",
      "GPIO4": "ENV_DHT_DATA",
      "GPIO5": "SPARE_ADC_CAPABLE",
      "GPIO6": "I2C_SDA",
      "GPIO7": "I2C_SCL",
      "GPIO10": "SPARE_DIGITAL"
    }
  },
  "nets": [
    {
      "name": "SYS_5V",
      "voltage": "5V regulated",
      "consumers": ["LD2410C", "3.3V regulator input"],
      "owner": "ADR-0007/IHAP-55"
    },
    {
      "name": "SYS_3V3",
      "voltage": "3.3V regulated",
      "consumers": ["ESP32-C3", "OLED", "ENV profile", "door pull-up"],
      "owner": "ADR-0007/IHAP-55"
    },
    {
      "name": "I2C_SDA",
      "gpio": "GPIO6",
      "consumers": ["OLED", "BME280 profile"]
    },
    {
      "name": "I2C_SCL",
      "gpio": "GPIO7",
      "consumers": ["OLED", "BME280 profile"]
    },
    {
      "name": "RADAR_RX_FROM_LD2410C_TX",
      "gpio": "GPIO0",
      "direction": "input_to_mcu",
      "baud": 256000
    },
    {
      "name": "RADAR_TX_TO_LD2410C_RX_SERVICE_ONLY",
      "gpio": "GPIO1",
      "direction": "output_from_mcu",
      "runtime_default": "disabled"
    },
    {
      "name": "DOOR_SENSE",
      "gpio": "GPIO3",
      "direction": "input_to_mcu",
      "bias": "10k pull-up to SYS_3V3"
    },
    {
      "name": "ENV_DHT_DATA",
      "gpio": "GPIO4",
      "direction": "bidirectional_single_wire",
      "pullup": "effective approx 5.1k to SYS_3V3"
    },
    {
      "name": "SPARE_ADC_CAPABLE",
      "gpio": "GPIO5",
      "direction": "spare",
      "adc_capability": "ADC2_CH0",
      "note": "Preserves ADR-0001 spare ADC-capable GPIO requirement"
    },
    {
      "name": "SPARE_DIGITAL",
      "gpio": "GPIO10",
      "direction": "spare"
    }
  ],
  "connectors": [
    {
      "id": "J_RADAR",
      "positions": 4,
      "pins": {"1": "GND", "2": "SYS_5V", "3": "RADAR_RX_FROM_LD2410C_TX", "4": "RADAR_TX_TO_LD2410C_RX_SERVICE_ONLY"}
    },
    {
      "id": "J_OLED",
      "positions": 4,
      "pins": {"1": "GND", "2": "SYS_3V3", "3": "I2C_SCL", "4": "I2C_SDA"}
    },
    {
      "id": "J_ENV",
      "positions": 5,
      "pins": {"1": "GND", "2": "SYS_3V3", "3": "ENV_DHT_DATA", "4": "I2C_SCL", "5": "I2C_SDA"}
    },
    {
      "id": "J_DOOR",
      "positions": 2,
      "pins": {"1": "GND", "2": "DOOR_SENSE"}
    }
  ],
  "mvp_zero_allocations": {
    "audio_gpio": 0,
    "audio_adc": 0,
    "audio_connector": 0
  },
  "review_history": [
    {
      "finding": "Initial draft incorrectly labeled GPIO10 as ADC-capable",
      "severity": "MAJOR",
      "disposition": "remediated_before_integrated_gate",
      "correction": "GPIO5 reserved as ADC-capable spare; I2C moved to GPIO6/GPIO7; GPIO10 retained as digital spare"
    }
  ]
}
