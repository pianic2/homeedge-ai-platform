{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pianic2/homeedge-ai-platform/tools/hardware-validation/ihap-47-door-state-sensor/results.schema.json",
  "title": "IHAP-47 Guided Door State Sensor Sanitized Summary",
  "type": "object",
  "required": [
    "schema_version",
    "issue",
    "generated_at_utc",
    "source_session",
    "physical_results_validated",
    "raw_logs_included",
    "captures",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "issue": {
      "const": "IHAP-47"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "source_session": {
      "type": "string",
      "minLength": 1
    },
    "evidence_class": {
      "enum": [
        "observed-owned-specimen-pending-review",
        "observed-owned-specimen-reviewed"
      ]
    },
    "physical_results_validated": {
      "type": "boolean"
    },
    "raw_logs_included": {
      "const": false
    },
    "execution_mode": {
      "type": [
        "string",
        "null"
      ]
    },
    "specimen_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "requested_cycles": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "records_count": {
      "type": "integer",
      "minimum": 0
    },
    "operator_observations_count": {
      "type": "integer",
      "minimum": 0
    },
    "capture_count": {
      "type": "integer",
      "minimum": 0
    },
    "captures_with_buffer_overflow": {
      "type": "integer",
      "minimum": 0
    },
    "mapping": {
      "type": "object",
      "properties": {
        "far_level": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "near_level": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        }
      },
      "additionalProperties": true
    },
    "cycle_test": {
      "type": "object",
      "properties": {
        "complete_cycles": {
          "type": "integer",
          "minimum": 0
        },
        "stable_movements": {
          "type": "integer",
          "minimum": 0
        },
        "mismatches": {
          "type": "integer",
          "minimum": 0
        },
        "buffer_overflows": {
          "type": "integer",
          "minimum": 0
        },
        "movements_with_multiple_raw_transitions": {
          "type": "integer",
          "minimum": 0
        },
        "max_raw_transition_span_us": {
          "type": "integer",
          "minimum": 0
        },
        "sample_period_us": {
          "type": "integer",
          "minimum": 1
        },
        "stable_window_ms": {
          "type": "integer",
          "minimum": 1
        },
        "pass": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "failure_modes": {
      "type": "object",
      "properties": {
        "disconnected_conductor_level": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "gpio_to_ground_level": {
          "type": "integer",
          "enum": [
            0,
            1
          ]
        },
        "pass": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "pull_up_bench_adequate": {
      "type": "boolean"
    },
    "decision_gate_pass": {
      "type": "boolean"
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "specimen_id",
          "initial_level",
          "final_level",
          "transition_count",
          "raw_transition_span_us",
          "sample_period_us",
          "buffer_overflow"
        ],
        "properties": {
          "test_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "specimen_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "initial_level": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              0,
              1,
              null
            ]
          },
          "final_level": {
            "type": [
              "integer",
              "null"
            ],
            "enum": [
              0,
              1,
              null
            ]
          },
          "transition_count": {
            "type": "integer",
            "minimum": 0
          },
          "raw_transition_span_us": {
            "type": "integer",
            "minimum": 0
          },
          "sample_period_us": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "buffer_overflow": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
